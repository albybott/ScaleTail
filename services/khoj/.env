#version=1.1
#URL=https://github.com/khoj-ai/khoj
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=khoj
IMAGE_URL=ghcr.io/khoj-ai/khoj:latest

# Network Configuration
SERVICEPORT=42110 # Khoj's default port. Uncomment the "ports:" section in compose.yaml to expose to LAN.
DNS_SERVER=9.9.9.9 # Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.

# Tailscale Configuration
TS_AUTHKEY= # Auth key from https://tailscale.com/admin/authkeys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.

# Time Zone setting for containers
TZ=Pacific/Auckland # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# PostgreSQL Database Configuration
POSTGRES_DB=khoj
POSTGRES_USER=khoj
POSTGRES_PASSWORD= # Generate a strong password (e.g., openssl rand -base64 32)

# Khoj Application Configuration
KHOJ_DJANGO_SECRET_KEY= # Generate a strong secret key (e.g., openssl rand -base64 64)
KHOJ_ADMIN_EMAIL=admin@example.com # Admin email for the admin panel
KHOJ_ADMIN_PASSWORD= # Generate a strong password for the admin panel

# Khoj Domain Configuration (for Tailscale Serve)
KHOJ_DOMAIN= # Auto-populated by Tailscale as $TS_CERT_DOMAIN
KHOJ_NO_HTTPS=True # Set to True since Tailscale handles HTTPS
KHOJ_ALLOWED_DOMAIN= # Auto-populated by Tailscale as $TS_CERT_DOMAIN

# AI Model API Keys (Optional - uncomment the ones you want to use)

# OpenAI API (Default option)
OPENAI_API_KEY=

# Anthropic API (Claude models)
# ANTHROPIC_API_KEY=

# Google Gemini API
# GEMINI_API_KEY=

# Local Ollama Configuration
# Uncomment in compose.yaml to use your local Ollama service instead of commercial APIs.
# When using Tailscale network mode, use the Ollama service's Tailscale hostname or IP.
# Example: OPENAI_BASE_URL=http://ollama.<tailnet-name>.ts.net:11434/v1
# - OPENAI_BASE_URL=http://ollama:11434/v1

# Optional Features (uncomment in compose.yaml to enable)

# Enable Khoj Computer/Operator capabilities
# KHOJ_OPERATOR_ENABLED=True

# Disable telemetry
# KHOJ_TELEMETRY_DISABLE=True
